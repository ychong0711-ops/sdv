[Unit]
Description=vsomeip routing daemon (SOME/IP)
After=network.target
Wants=network.target

[Service]
Type=simple
Environment=VSOMEIP_CONFIGURATION=/etc/vsomeip/vsomeip.json
Environment=VSOMEIP_APPLICATION_NAME=sdv-routingd
ExecStart=/usr/bin/vsomeipd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
